# Copy to mobile/.env

# SaveLoom API — must be reachable from where you run the app.
#
# Expo web / iOS simulator / Android emulator (same machine as npm run dev):
EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Physical phone only — localhost won't work. Start a tunnel and paste the https URL:
#   Terminal A: npm run dev          (repo root)
#   Terminal B: npx cloudflared tunnel --url http://localhost:3000
# EXPO_PUBLIC_API_URL=https://YOUR-SUBDOMAIN.trycloudflare.com

# Google OAuth (same Web client ID as root AUTH_GOOGLE_ID)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# --- Development only ---
# Skip login and use mock data. MUST be false (or unset) for production testing.
# EXPO_PUBLIC_DEV_BYPASS_AUTH=false

# Optional: use your real SaveLoom account instead of mock data in dev bypass mode.
# 1. Sign in at http://localhost:3000 in your browser
# 2. Open http://localhost:3000/dev/mobile-token
# 3. Paste the line below and restart Expo
# EXPO_PUBLIC_DEV_ACCESS_TOKEN=your-jwt-here
