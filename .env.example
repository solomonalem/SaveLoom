# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it is gitignored.
#
# When adding new variables, update the schema in `src/env.js` as well.

# -----------------------------------------------------------------------------
# Auth (NextAuth.js + Google OAuth)
# -----------------------------------------------------------------------------
# Generate a secret: npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Google OAuth credentials from https://console.cloud.google.com/
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# -----------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# -----------------------------------------------------------------------------
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Use `./start-database.sh` to spin up a local Postgres container from this URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/SaveLoom"

# -----------------------------------------------------------------------------
# Plaid (bank account linking)
# -----------------------------------------------------------------------------
# Get sandbox keys from https://dashboard.plaid.com/
# Use "sandbox" for local development.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
NEXT_PUBLIC_PLAID_ENV="sandbox"

# -----------------------------------------------------------------------------
# AI (Anthropic Claude — optional for non-AI pages)
# -----------------------------------------------------------------------------
# Required for AI insights and recommendations (/api/ai/*).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=""
